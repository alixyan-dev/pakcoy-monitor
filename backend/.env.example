# === Database ===
# Development (SQLite):
DATABASE_URL=sqlite:///data/pakcoy.db
# Production (Neon PostgreSQL):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# === Data & model ===
EXCEL_PATH=data/new Dataset_Pakcoy.xlsx
IMAGE_DIR=data/images
MODEL_ARTIFACTS_DIR=app/ml/artifacts
TRAINED_ARTIFACTS_DIR=ml/artifacts

# === OpenRouter (AI Assistant) ===
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# === Foto representatif per stage (opsional) ===
# Format: stage=relative_path|stage=relative_path
# Jika kosong, default = file pertama yang valid per folder.
IMAGE_MAP=

# === API ===
CORS_ORIGINS=http://localhost:3000
